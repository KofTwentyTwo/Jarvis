<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Plan 05-03: ONLY mcp-applescript may hold this entitlement.
         scripts/verify-entitlements.sh --post-codesign enforces this both
         ways: this helper MUST carry it; no other helper may. Adding any
         other key here would land on the build-time forbidden list. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
